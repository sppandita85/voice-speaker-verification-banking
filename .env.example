# --- Database ---
DATABASE_URL=postgresql+psycopg://voicebot:voicebot@localhost:5434/voicebot
# Salt used to hash mobile numbers (change it; it is not a secret in this demo)
MOBILE_HASH_SALT=demo-salt-change-me

# --- Language (only "en" is implemented; prompts, messages and voices are keyed by it) ---
LANGUAGE=en

# --- Providers: "real" uses local models, "fake" needs nothing (tests / quick UI demo) ---
SPEECH_PROVIDER=real
LLM_PROVIDER=ollama

# --- Speech-to-text (faster-whisper) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Text-to-speech (Piper) ---
PIPER_VOICE_EN=models/piper/en_US-lessac-medium.onnx

# --- Voice ID (SpeechBrain ECAPA) ---
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_SAVEDIR=models/ecapa
VOICE_ACCEPT_THRESHOLD=0.55
VOICE_STEPUP_THRESHOLD=0.40
VOICE_MIN_SECONDS=1.5
MAX_VERIFY_ATTEMPTS=3
LOCK_MINUTES=5

# --- LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
PROMPT_VERSION=v1
